    "audit": "audit/TNSI_EXAM_BANK_AUDIT.json"
  },
  "expected_gate_behaviour": {
    "check": "rc 0",
    "validate-model": "rouge sur ces empreintes",
    "fail-on-new": "rouge sur ces empreintes",
    "release-strict": "rouge"
  },
