    "audit": "audit/METHOD_SHEET_REQUIREMENT_AUDIT.json"
  },
  "expected_gate_behaviour": {
    "check": "rc 0",
    "validate-model": "rouge sur ces vingt empreintes",
    "fail-on-new": "rouge sur ces vingt empreintes",
    "release-strict": "rouge"
  },
