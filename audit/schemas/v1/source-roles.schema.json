{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:source-roles",
  "title": "Nexus source roles control file v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "control_digest",
    "default",
    "role_order",
    "roles",
    "schema_ref",
    "schema_version"
  ],
  "properties": {
    "artifact_type": { "const": "source_roles" },
    "control_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "default": { "type": "string", "minLength": 1 },
    "role_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      }
    },
    "schema_ref": { "const": "audit/schemas/v1/source-roles.schema.json" },
    "schema_version": { "const": 1 }
  }
}
