{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/v1/human-review-governance.schema.json",
  "title": "Nexus human review governance contract",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "human_review_receipt_schema_version",
    "decision",
    "roles",
    "role_dimensions",
    "machine_actors_forbidden_as_reviewer",
    "forbidden_reviewer_identity_patterns",
    "granularity",
    "frozen_set_rules",
    "verdicts",
    "forbidden_verdicts",
    "digests",
    "traceability",
    "staleness",
    "packet_a_controls",
    "packet_b_controls",
    "qcm_human_gate",
    "receipt",
    "attestation",
    "approval_rule",
    "independence",
    "status_transitions",
    "full_atom_criteria",
    "any_pending_criterion_forbids_full",
    "visual_authority",
    "mutation_tests",
    "chapter_states"
  ],
  "properties": {
    "artifact_type": {
      "const": "human_review_governance"
    },
    "schema_version": {
      "const": 1
    },
    "human_review_receipt_schema_version": {
      "const": 1
    },
    "granularity": {
      "const": "frozen_chapter"
    },
    "machine_actors_forbidden_as_reviewer": {
      "const": true
    },
    "any_pending_criterion_forbids_full": {
      "const": true
    },
    "verdicts": {
      "type": "array",
      "items": {
        "enum": [
          "APPROVED",
          "CHANGES_REQUESTED",
          "REJECTED"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "forbidden_verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_reviewer_identity_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "regex"
      },
      "minItems": 1
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "manuals",
          "review_a",
          "review_b"
        ],
        "properties": {
          "manuals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "review_a": {
            "type": "string",
            "minLength": 1
          },
          "review_b": {
            "type": "string",
            "minLength": 1
          },
          "role_provenance": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "date",
        "approves_no_chapter",
        "publication_approval",
        "release_acceptance",
        "baseline_update",
        "d7_oracle_modified"
      ],
      "properties": {
        "approves_no_chapter": {
          "const": true
        },
        "publication_approval": {
          "const": false
        },
        "release_acceptance": {
          "const": false
        },
        "baseline_update": {
          "const": false
        },
        "d7_oracle_modified": {
          "const": false
        }
      }
    },
    "independence": {
      "type": "object",
      "required": [
        "distinct_reviewer_identity_reference_required",
        "same_human_cannot_satisfy_both_roles"
      ],
      "properties": {
        "distinct_reviewer_identity_reference_required": {
          "const": true
        },
        "same_human_cannot_satisfy_both_roles": {
          "const": true
        }
      }
    },
    "approval_rule": {
      "type": "object",
      "required": [
        "approved_requires_empty_blocking_findings",
        "changes_requested_requires_findings",
        "finding_required_fields",
        "after_correction"
      ],
      "properties": {
        "approved_requires_empty_blocking_findings": {
          "const": true
        },
        "changes_requested_requires_findings": {
          "const": true
        },
        "finding_required_fields": {
          "type": "array",
          "items": {
            "enum": [
              "finding_id",
              "object_ref",
              "severity",
              "description"
            ]
          },
          "minItems": 4
        }
      }
    },
    "qcm_human_gate": {
      "type": "object",
      "required": [
        "third_independent_reviewer_required",
        "condition_a",
        "condition_b",
        "satisfied_when",
        "otherwise",
        "out_of_set_qcm_never_benefits_from_chapter_receipt"
      ],
      "properties": {
        "otherwise": {
          "const": "PENDING"
        },
        "out_of_set_qcm_never_benefits_from_chapter_receipt": {
          "const": true
        },
        "satisfied_when": {
          "type": "object",
          "required": [
            "review_a",
            "review_b"
          ],
          "properties": {
            "review_a": {
              "const": "APPROVED"
            },
            "review_b": {
              "const": "APPROVED"
            }
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "required": [
        "algorithm",
        "object_set_digest",
        "packet_digest",
        "programme_authority_digest",
        "review_render_digest",
        "semantic_review_digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "review_render_digest": {
          "type": "object",
          "required": [
            "independent_from_semantic"
          ],
          "properties": {
            "independent_from_semantic": {
              "const": true
            }
          }
        },
        "semantic_review_digest": {
          "type": "object",
          "required": [
            "governance_exclusion_allowlist"
          ],
          "properties": {
            "governance_exclusion_allowlist": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "meta_fields",
                "contract_fields",
                "closed",
                "widening_requires"
              ],
              "properties": {
                "meta_fields": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "status"
                    ]
                  },
                  "maxItems": 1,
                  "uniqueItems": true
                },
                "contract_fields": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "statut"
                    ]
                  },
                  "maxItems": 1,
                  "uniqueItems": true
                },
                "closed": {
                  "const": true
                },
                "widening_requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    "visual_authority": {
      "type": "object",
      "required": [
        "d7_independent_of_content_completion",
        "content_completion_does_not_imply"
      ],
      "properties": {
        "d7_independent_of_content_completion": {
          "const": true
        },
        "content_completion_does_not_imply": {
          "type": "array",
          "items": {
            "enum": [
              "VISUAL_COMPLETE",
              "D7_APPROVED",
              "PRINT_READY",
              "PUBLISH_READY"
            ]
          },
          "minItems": 4
        }
      }
    },
    "status_transitions": {
      "type": "object",
      "required": [
        "canonical_status_enum",
        "table",
        "contract_transitions",
        "prohibited_without_human_receipt",
        "out_of_frozen_set_promotion"
      ],
      "properties": {
        "out_of_frozen_set_promotion": {
          "const": "forbidden"
        },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "current_status",
              "required_machine_dimensions",
              "required_human_receipts",
              "next_canonical_status"
            ],
            "properties": {
              "current_status": {
                "type": "string"
              },
              "required_machine_dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_human_receipts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "next_canonical_status": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "mutation_tests": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "I",
              "J",
              "K"
            ]
          }
        }
      }
    }
  }
}
