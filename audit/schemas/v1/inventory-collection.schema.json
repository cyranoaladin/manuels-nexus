{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:inventory-collection",
  "title": "Nexus collection inventory artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anomalies",
    "anomaly_qualifications",
    "artifact_type",
    "assemblies",
    "coherence_checks",
    "correction_links",
    "declared_assemblies",
    "deliverable_matrix",
    "generated_by",
    "manuals",
    "model_digest",
    "observed_build_coverage",
    "observed_build_integration",
    "observed_builds",
    "pdfs",
    "provenance",
    "reference_graph",
    "report_reconciliation",
    "schema_ref",
    "schema_version",
    "source_digest",
    "source_file_count",
    "source_files"
  ],
  "properties": {
    "anomalies": { "type": "object", "additionalProperties": { "type": "array" } },
    "anomaly_qualifications": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "artifact_type": { "const": "inventory_collection" },
    "assemblies": { "type": "array" },
    "coherence_checks": { "type": "object" },
    "correction_links": { "type": "array" },
    "declared_assemblies": { "type": "array" },
    "deliverable_matrix": { "type": "object" },
    "generated_by": { "const": "inventory_collection.py" },
    "manuals": { "type": "object" },
    "model_digest": { "$ref": "#/$defs/sha256" },
    "observed_build_coverage": { "type": "object" },
    "observed_build_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembler_mismatches",
        "duplicate_assembly_ids",
        "entrypoint",
        "integrated_producers",
        "missing_assembly_ids",
        "recorder_mismatches",
        "required_producers",
        "status",
        "unexpected_assembly_ids",
        "unobserved_assembly_ids"
      ],
      "properties": {
        "assembler_mismatches": { "$ref": "#/$defs/stringList" },
        "duplicate_assembly_ids": { "$ref": "#/$defs/stringList" },
        "entrypoint": {
          "const": "python scripts/build_manifest.py --receipt <build-receipt.json>"
        },
        "integrated_producers": { "$ref": "#/$defs/stringList" },
        "missing_assembly_ids": { "$ref": "#/$defs/stringList" },
        "recorder_mismatches": { "$ref": "#/$defs/stringList" },
        "required_producers": { "$ref": "#/$defs/stringList" },
        "status": { "enum": ["integrated", "not_integrated"] },
        "unexpected_assembly_ids": { "$ref": "#/$defs/stringList" },
        "unobserved_assembly_ids": { "$ref": "#/$defs/stringList" }
      }
    },
    "observed_builds": { "type": "array" },
    "pdfs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pdfArtifact" }
    },
    "provenance": { "type": "object" },
    "reference_graph": { "type": "array" },
    "report_reconciliation": { "type": "object" },
    "schema_ref": { "const": "audit/schemas/v1/inventory-collection.schema.json" },
    "schema_version": { "const": 1 },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "source_file_count": { "type": "integer", "minimum": 0 },
    "source_files": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "pdfArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "manual",
        "page_count",
        "page_count_method",
        "path",
        "reason",
        "scope",
        "sha256",
        "source_role",
        "status",
        "variant"
      ],
      "properties": {
        "artifact_role": {
          "enum": [
            "HISTORICAL_PUBLICATION_SNAPSHOT",
            "OFFICIAL_PROGRAM_AUTHORITY",
            "HARVEST_NON_PUBLISHABLE_HISTORICAL_RENDER"
          ]
        },
        "audience": { "enum": ["PROFESSOR_ONLY", "STUDENT_FACING"] },
        "chapter": { "type": ["string", "null"] },
        "compilation_evidence": { "const": false },
        "manual": {
          "type": ["string", "null"],
          "enum": [null, "1SPE", "TSPE_2026_2027", "TCOMPL", "TEXPERTES", "1NSI", "TNSI"]
        },
        "page_count": { "type": ["integer", "null"], "minimum": 1 },
        "page_count_method": {
          "type": ["string", "null"],
          "enum": [null, "pdfinfo", "python"]
        },
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "registry_digest": { "$ref": "#/$defs/sha256" },
        "registry_source": { "const": "audit/PDF_ARTIFACT_REGISTRY.yaml" },
        "release_state": {
          "enum": ["STALE_UNDECIDED", "REFERENCE_ONLY", "NON_PUBLISHABLE"]
        },
        "scope": { "type": ["string", "null"] },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "source_role": { "type": "string", "minLength": 1 },
        "status": { "enum": ["counted", "page_count_unavailable"] },
        "variant": { "type": ["string", "null"] }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["artifact_role"] },
              { "required": ["audience"] },
              { "required": ["compilation_evidence"] },
              { "required": ["registry_digest"] },
              { "required": ["registry_source"] },
              { "required": ["release_state"] }
            ]
          }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/registeredCountedPdfState" }
          ],
          "required": [
            "artifact_role",
            "compilation_evidence",
            "registry_digest",
            "registry_source",
            "release_state"
          ],
          "properties": {
            "artifact_role": { "const": "HISTORICAL_PUBLICATION_SNAPSHOT" },
            "chapter": { "type": "null" },
            "release_state": { "const": "STALE_UNDECIDED" },
            "scope": { "const": "publication_snapshot" },
            "source_role": { "const": "transversal" },
            "variant": { "enum": ["eleve", "professeur"] }
          },
          "not": { "required": ["audience"] }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/registeredCountedPdfState" }
          ],
          "required": [
            "artifact_role",
            "compilation_evidence",
            "registry_digest",
            "registry_source",
            "release_state"
          ],
          "properties": {
            "artifact_role": { "const": "OFFICIAL_PROGRAM_AUTHORITY" },
            "chapter": { "type": "null" },
            "release_state": { "const": "REFERENCE_ONLY" },
            "scope": { "const": "official_program_authority" },
            "source_role": { "const": "transversal" },
            "variant": { "type": "null" }
          },
          "not": { "required": ["audience"] }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/registeredCountedPdfState" }
          ],
          "required": [
            "artifact_role",
            "audience",
            "compilation_evidence",
            "registry_digest",
            "registry_source",
            "release_state"
          ],
          "properties": {
            "artifact_role": { "const": "HARVEST_NON_PUBLISHABLE_HISTORICAL_RENDER" },
            "chapter": { "const": "1NSI-ALGO-DICHO-GLOUTON-KNN" },
            "manual": { "const": "1NSI" },
            "release_state": { "const": "NON_PUBLISHABLE" },
            "scope": { "const": "harvest_historical_render" },
            "source_role": { "const": "transversal" },
            "variant": { "type": "null" }
          },
          "oneOf": [
            {
              "properties": {
                "audience": { "const": "PROFESSOR_ONLY" },
                "path": { "pattern": "/P13_(?:corrige|td|tp)\\.pdf$" }
              }
            },
            {
              "properties": {
                "audience": { "const": "STUDENT_FACING" },
                "path": { "pattern": "/P13_(?:aides|cours|evaluation|fiche_methode|trace)\\.pdf$" }
              }
            }
          ]
        }
      ]
    },
    "registeredCountedPdfState": {
      "type": "object",
      "required": [
        "sha256",
        "page_count",
        "page_count_method",
        "status",
        "reason"
      ],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "page_count": { "type": "integer", "minimum": 1 },
        "page_count_method": { "enum": ["pdfinfo", "python"] },
        "status": { "const": "counted" },
        "reason": { "type": "null" }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
