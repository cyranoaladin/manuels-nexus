{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:baseline-qualification-policy",
  "title": "Nexus baseline qualification policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed_dispositions",
    "approved_set",
    "approved_transition",
    "artifact_type",
    "control_digest",
    "decision",
    "initial_policy",
    "owners",
    "rules",
    "schema_ref",
    "schema_version"
  ],
  "properties": {
    "allowed_dispositions": {
      "type": "array",
      "prefixItems": [
        { "const": "open_debt" },
        { "const": "generated_dependency" },
        { "const": "harvest_candidate" },
        { "const": "intentional_reuse" },
        { "const": "false_positive" },
        { "const": "accepted_exception" },
        { "const": "fixed" }
      ],
      "items": false
    },
    "approved_set": { "$ref": "#/$defs/approved_set" },
    "approved_transition": { "$ref": "#/$defs/approved_transition" },
    "artifact_type": { "const": "baseline_qualification_policy" },
    "control_digest": { "$ref": "#/$defs/sha256" },
    "decision": { "$ref": "#/$defs/decision" },
    "initial_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_outputs"],
      "properties": {
        "prohibited_outputs": {
          "const": ["accepted_exception", "false_positive", "fixed"]
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_editoriale_pedagogique",
        "direction_scientifique_programme",
        "ingenierie_build_qualite"
      ],
      "properties": {
        "direction_editoriale_pedagogique": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "pedagogy",
                "nexus_mastery_loop",
                "student_teacher_variants",
                "remediation",
                "editorial_content",
                "terminology"
              ]
            }
          }
        },
        "direction_scientifique_programme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "mathematics",
                "official_programme",
                "demonstrations",
                "qcm",
                "corrections",
                "numerical_results"
              ]
            }
          }
        },
        "ingenierie_build_qualite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "metadata",
                "inventory",
                "assemblies",
                "latex",
                "python",
                "ci",
                "pdf",
                "visual_baselines"
              ]
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "schema_ref": {
      "const": "audit/schemas/v1/baseline-qualification-policy.schema.json"
    },
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "approved_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_sha",
        "category_counts",
        "fingerprint_count",
        "fingerprint_digest",
        "observed_model_digest_before_materialization",
        "observed_source_digest_before_materialization",
        "owner_counts"
      ],
      "properties": {
        "baseline_sha": {
          "const": "afae475ee06e8510804c0065ccfd35dfa0199875"
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocking_statuses"],
          "properties": {
            "blocking_statuses": { "const": 189 }
          }
        },
        "fingerprint_count": { "const": 189 },
        "fingerprint_digest": {
          "const": "sha256:6a994806a4a3b8c710fb0eb2e089e90e8666543b3380e4ccf0cf5268500f86ca"
        },
        "observed_model_digest_before_materialization": {
          "const": "sha256:f273dd51de99b09c8ef3846c2974556ed9ce11a8cc5e8cc8cfb0820d42e51548"
        },
        "observed_source_digest_before_materialization": {
          "const": "sha256:8fda81f750904276cff25878f84fb196ac3f1b26c30c62ec054f2f09ab691b81"
        },
        "owner_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme"
          ],
          "properties": {
            "direction_editoriale_pedagogique": { "const": 10 },
            "direction_scientifique_programme": { "const": 179 }
          }
        }
      }
    },
    "approved_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_active_fingerprint_count",
        "initial_active_fingerprint_count",
        "initial_baseline_digest",
        "initial_resolved_fingerprint_count",
        "modified_pairs",
        "modified_pairs_digest",
        "resolved_category_counts",
        "resolved_fingerprint_count",
        "resolved_fingerprint_digest",
        "retained_fingerprint_count"
      ],
      "properties": {
        "final_active_fingerprint_count": { "const": 2866 },
        "initial_active_fingerprint_count": { "const": 2986 },
        "initial_baseline_digest": {
          "const": "sha256:ebe9580cae8f994a19bb82960762a845c19e2c9a6e006aae244dcebc26ca3bbb"
        },
        "initial_resolved_fingerprint_count": { "const": 642 },
        "modified_pairs": {
          "type": "array",
          "minItems": 189,
          "maxItems": 189,
          "items": { "$ref": "#/$defs/modified_pair" },
          "uniqueItems": true
        },
        "modified_pairs_digest": {
          "const": "sha256:b744f797cb072e7c1200b5e8c87a2ef7b16076578e53e1e70e15b764988ea3e0"
        },
        "resolved_category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_statuses",
            "chapters_not_in_manual",
            "missing_assemblers",
            "unassembled_objects"
          ],
          "properties": {
            "blocking_statuses": { "const": 189 },
            "chapters_not_in_manual": { "const": 10 },
            "missing_assemblers": { "const": 1 },
            "unassembled_objects": { "const": 109 }
          }
        },
        "resolved_fingerprint_count": { "const": 309 },
        "resolved_fingerprint_digest": {
          "const": "sha256:b652287acfa1d91c62446b1dc3f251b46980ca6363968a14733b3e2e91bf3631"
        },
        "retained_fingerprint_count": { "const": 2677 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approver_role",
        "baseline_purpose",
        "id",
        "provisional_after_freeze",
        "ref",
        "release_acceptance"
      ],
      "properties": {
        "approved_by": { "const": "Alaeddine Ben Rhouma" },
        "approver_role": {
          "const": "Direction scientifique et éditoriale Nexus Réussite"
        },
        "baseline_purpose": { "const": "debt_regression_control" },
        "id": { "const": "baseline-status-governance-1nsi-2026-08-10" },
        "provisional_after_freeze": { "const": false },
        "ref": {
          "const": "audit/BASELINE_QUALIFICATION_DECISION.md#decision-baseline-status-governance-1nsi-2026-08-10"
        },
        "release_acceptance": { "const": false }
      }
    },
    "decision_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "owner", "reason", "release_blocking"],
      "properties": {
        "disposition": {
          "enum": [
            "open_debt",
            "generated_dependency",
            "harvest_candidate",
            "intentional_reuse"
          ]
        },
        "owner": {
          "enum": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme",
            "ingenierie_build_qualite"
          ]
        },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" }
      }
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "field_equals": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "integer", "number", "string", "null"]
          }
        },
        "field_in": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": ["boolean", "integer", "number", "string", "null"]
            },
            "uniqueItems": true
          }
        },
        "not_all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "source_glob": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "not": {
            "required": ["all_true", "not_all_true"]
          }
        }
      ]
    },
    "modified_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "previous"],
      "properties": {
        "current": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "previous": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "id", "match", "order"],
      "properties": {
        "decision": { "$ref": "#/$defs/decision_output" },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "match": { "$ref": "#/$defs/match" },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
