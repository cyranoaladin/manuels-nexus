{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:baseline-qualification-policy",
  "title": "Nexus baseline qualification policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed_dispositions",
    "approved_set",
    "approved_transition",
    "artifact_type",
    "control_digest",
    "decision",
    "initial_policy",
    "owners",
    "rules",
    "schema_ref",
    "schema_version"
  ],
  "properties": {
    "allowed_dispositions": {
      "type": "array",
      "prefixItems": [
        { "const": "open_debt" },
        { "const": "generated_dependency" },
        { "const": "harvest_candidate" },
        { "const": "intentional_reuse" },
        { "const": "false_positive" },
        { "const": "accepted_exception" },
        { "const": "fixed" }
      ],
      "items": false
    },
    "approved_set": { "$ref": "#/$defs/approved_set" },
    "approved_transition": { "$ref": "#/$defs/approved_transition" },
    "artifact_type": { "const": "baseline_qualification_policy" },
    "control_digest": { "$ref": "#/$defs/sha256" },
    "decision": { "$ref": "#/$defs/decision" },
    "initial_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_outputs"],
      "properties": {
        "prohibited_outputs": {
          "const": ["accepted_exception", "false_positive", "fixed"]
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_editoriale_pedagogique",
        "direction_scientifique_programme",
        "ingenierie_build_qualite"
      ],
      "properties": {
        "direction_editoriale_pedagogique": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "pedagogy",
                "nexus_mastery_loop",
                "student_teacher_variants",
                "remediation",
                "editorial_content",
                "terminology"
              ]
            }
          }
        },
        "direction_scientifique_programme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "mathematics",
                "official_programme",
                "demonstrations",
                "qcm",
                "corrections",
                "numerical_results"
              ]
            }
          }
        },
        "ingenierie_build_qualite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "metadata",
                "inventory",
                "assemblies",
                "latex",
                "python",
                "ci",
                "pdf",
                "visual_baselines"
              ]
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "schema_ref": {
      "const": "audit/schemas/v1/baseline-qualification-policy.schema.json"
    },
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "approved_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_sha",
        "category_counts",
        "fingerprint_count",
        "fingerprint_digest",
        "fingerprints",
        "observed_model_digest_before_materialization",
        "observed_source_digest_before_materialization",
        "owner_counts"
      ],
      "properties": {
        "baseline_sha": {
          "const": "0543df60f4931f0e9e24ce23a9635f203f3a3a53"
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocking_statuses"],
          "properties": {
            "blocking_statuses": { "const": 13 }
          }
        },
        "fingerprint_count": { "const": 13 },
        "fingerprint_digest": {
          "const": "sha256:1abe51ad406752b1e09996020c1afb2db3982ac2741cf98ed7b2118f302ace98"
        },
        "fingerprints": {
          "const": [
            "18c7b3aa6301ef4c",
            "33e9818ffc70892c",
            "47fd672690479f1f",
            "4b9a00c4ef815951",
            "634c54857f49fcc0",
            "80b7b42e7d6a78ba",
            "85454c002c0a1d6a",
            "873a020438d7e00a",
            "8ca4f3f2a9212e39",
            "bd63d2a316c26b0c",
            "d6985b17d7cab316",
            "dc8e5dcc030bb539",
            "e8ac154947fefcdb"
          ]
        },
        "observed_model_digest_before_materialization": {
          "const": "sha256:9560f7e883448fef80a6bc4643afbc011ef0bf8a94048e5098fd795a8e421aa2"
        },
        "observed_source_digest_before_materialization": {
          "const": "sha256:d9186c56f6d05bb5d8d47a644a96ef58819d80f57d0d011e45b4c27b4e370d9c"
        },
        "owner_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme",
            "ingenierie_build_qualite"
          ],
          "properties": {
            "direction_editoriale_pedagogique": { "const": 2 },
            "direction_scientifique_programme": { "const": 10 },
            "ingenierie_build_qualite": { "const": 1 }
          }
        }
      }
    },
    "approved_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_active_fingerprint_count",
        "expected_review_debt_count",
        "expected_review_debt_digest",
        "initial_active_fingerprint_count",
        "initial_baseline_digest",
        "initial_resolved_fingerprint_count",
        "historical_qualification",
        "modified_pairs",
        "modified_pairs_digest",
        "resolved_category_counts",
        "resolved_fingerprint_count",
        "resolved_fingerprint_digest",
        "resolved_outside_transition_category_counts",
        "resolved_outside_transition_count",
        "resolved_outside_transition_digest",
        "retained_fingerprint_count"
      ],
      "properties": {
        "expected_review_debt_count": { "const": 89 },
        "expected_review_debt_digest": {
          "const": "sha256:8daf2b85cecb556daa788056c66060ee6e0c20d00a09c976b9bac9f1bd9d8303"
        },
        "historical_qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_by",
            "baseline_sha",
            "decision_ref",
            "qualification_policy_digest"
          ],
          "properties": {
            "approved_by": { "const": "Alaeddine Ben Rhouma" },
            "baseline_sha": {
              "const": "afae475ee06e8510804c0065ccfd35dfa0199875"
            },
            "decision_ref": {
              "const": "audit/BASELINE_QUALIFICATION_DECISION.md#decision-baseline-status-governance-1nsi-2026-08-10"
            },
            "qualification_policy_digest": {
              "const": "sha256:34341425e865bb72129064438631fe3ae9af3a78dd0b647b5b7276bdabee77a9"
            }
          }
        },
        "final_active_fingerprint_count": { "const": 2232 },
        "initial_active_fingerprint_count": { "const": 6541 },
        "initial_baseline_digest": {
          "const": "sha256:c34d3f29085e6421e663c51980d1f47b7b8ccc55f0f178c54cc36c5d2c15927c"
        },
        "initial_resolved_fingerprint_count": { "const": 951 },
        "modified_pairs": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/modified_pair" },
          "uniqueItems": true
        },
        "modified_pairs_digest": {
          "const": "sha256:78bea6cea278b3b3850a2f42364fee0b6c51033e90e83f85591dccca51759273"
        },
        "resolved_category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_statuses",
            "broken_latex_references",
            "broken_meta_references",
            "context_mismatches",
            "duplicate_assembly_objects",
            "duplicate_ids",
            "latex_cycles",
            "missing_corrections",
            "orphan_files",
            "unassembled_objects",
            "unattributed_pdfs",
            "unclassified_types"
          ],
          "properties": {
            "blocking_statuses": { "const": 26 },
            "broken_latex_references": { "const": 5 },
            "broken_meta_references": { "const": 2845 },
            "context_mismatches": { "const": 3 },
            "duplicate_assembly_objects": { "const": 3 },
            "duplicate_ids": { "const": 125 },
            "latex_cycles": { "const": 10 },
            "missing_corrections": { "const": 629 },
            "orphan_files": { "const": 12 },
            "unassembled_objects": { "const": 52 },
            "unattributed_pdfs": { "const": 22 },
            "unclassified_types": { "const": 688 }
          }
        },
        "resolved_fingerprint_count": { "const": 4420 },
        "resolved_fingerprint_digest": {
          "const": "sha256:6afe2c9222e176686de4cf57b8c4aa53ecd7b9202326b09ec6dec3c7bd1140e0"
        },
        "resolved_outside_transition_category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_statuses",
            "broken_latex_references",
            "broken_meta_references",
            "context_mismatches",
            "duplicate_assembly_objects",
            "duplicate_ids",
            "latex_cycles",
            "missing_corrections",
            "orphan_files",
            "unassembled_objects",
            "unattributed_pdfs",
            "unclassified_types"
          ],
          "properties": {
            "blocking_statuses": { "const": 17 },
            "broken_latex_references": { "const": 5 },
            "broken_meta_references": { "const": 2845 },
            "context_mismatches": { "const": 3 },
            "duplicate_assembly_objects": { "const": 3 },
            "duplicate_ids": { "const": 125 },
            "latex_cycles": { "const": 10 },
            "missing_corrections": { "const": 629 },
            "orphan_files": { "const": 12 },
            "unassembled_objects": { "const": 52 },
            "unattributed_pdfs": { "const": 22 },
            "unclassified_types": { "const": 688 }
          }
        },
        "resolved_outside_transition_count": { "const": 4411 },
        "resolved_outside_transition_digest": {
          "const": "sha256:0f5290c778717ec21bf8b64861e95b3412044b92b18da73c048d66fc4aadd188"
        },
        "retained_fingerprint_count": { "const": 2121 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approver_role",
        "baseline_purpose",
        "id",
        "provisional_after_freeze",
        "ref",
        "release_acceptance"
      ],
      "properties": {
        "approved_by": { "const": "Alaeddine Ben Rhouma" },
        "approver_role": {
          "const": "Direction scientifique et éditoriale Nexus Réussite"
        },
        "baseline_purpose": { "const": "debt_regression_control" },
        "id": { "const": "baseline-residual-13-temporary-2026-08-25" },
        "provisional_after_freeze": { "const": false },
        "ref": {
          "const": "audit/BASELINE_QUALIFICATION_DECISION.md#decision-baseline-residual-13-temporary-2026-08-25"
        },
        "release_acceptance": { "const": false }
      }
    },
    "decision_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "owner", "reason", "release_blocking"],
      "properties": {
        "disposition": {
          "enum": [
            "open_debt",
            "generated_dependency",
            "harvest_candidate",
            "intentional_reuse"
          ]
        },
        "owner": {
          "enum": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme",
            "ingenierie_build_qualite"
          ]
        },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" }
      }
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "field_equals": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "integer", "number", "string", "null"]
          }
        },
        "field_in": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": ["boolean", "integer", "number", "string", "null"]
            },
            "uniqueItems": true
          }
        },
        "not_all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "source_glob": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "not": {
            "required": ["all_true", "not_all_true"]
          }
        }
      ]
    },
    "modified_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "previous"],
      "properties": {
        "current": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "previous": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "id", "match", "order"],
      "properties": {
        "decision": { "$ref": "#/$defs/decision_output" },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "match": { "$ref": "#/$defs/match" },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
