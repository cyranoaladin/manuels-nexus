{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:baseline-qualification-policy",
  "title": "Nexus baseline qualification policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed_dispositions",
    "approved_set",
    "approved_transition",
    "artifact_type",
    "control_digest",
    "decision",
    "initial_policy",
    "owners",
    "rules",
    "schema_ref",
    "schema_version"
  ],
  "properties": {
    "allowed_dispositions": {
      "type": "array",
      "prefixItems": [
        { "const": "open_debt" },
        { "const": "generated_dependency" },
        { "const": "harvest_candidate" },
        { "const": "intentional_reuse" },
        { "const": "false_positive" },
        { "const": "accepted_exception" },
        { "const": "fixed" }
      ],
      "items": false
    },
    "approved_set": { "$ref": "#/$defs/approved_set" },
    "approved_transition": { "$ref": "#/$defs/approved_transition" },
    "artifact_type": { "const": "baseline_qualification_policy" },
    "control_digest": { "$ref": "#/$defs/sha256" },
    "decision": { "$ref": "#/$defs/decision" },
    "initial_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibited_outputs"],
      "properties": {
        "prohibited_outputs": {
          "const": ["accepted_exception", "false_positive", "fixed"]
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_editoriale_pedagogique",
        "direction_scientifique_programme",
        "ingenierie_build_qualite"
      ],
      "properties": {
        "direction_editoriale_pedagogique": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "pedagogy",
                "nexus_mastery_loop",
                "student_teacher_variants",
                "remediation",
                "editorial_content",
                "terminology"
              ]
            }
          }
        },
        "direction_scientifique_programme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "mathematics",
                "official_programme",
                "demonstrations",
                "qcm",
                "corrections",
                "numerical_results"
              ]
            }
          }
        },
        "ingenierie_build_qualite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": [
                "metadata",
                "inventory",
                "assemblies",
                "latex",
                "python",
                "ci",
                "pdf",
                "visual_baselines"
              ]
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "schema_ref": {
      "const": "audit/schemas/v1/baseline-qualification-policy.schema.json"
    },
    "schema_version": { "const": 1 }
  },
  "$defs": {
    "approved_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_sha",
        "category_counts",
        "fingerprint_count",
        "fingerprint_digest",
        "observed_model_digest_before_materialization",
        "observed_source_digest_before_materialization",
        "owner_counts"
      ],
      "properties": {
        "baseline_sha": {
          "const": "a48e8e41fc3f6ef9274e564722d5155c8df401b7"
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_statuses",
            "broken_meta_references",
            "chapters_not_in_manual",
            "unassembled_objects",
            "unclassified_types"
          ],
          "properties": {
            "blocking_statuses": { "const": 875 },
            "broken_meta_references": { "const": 2 },
            "chapters_not_in_manual": { "const": 15 },
            "unassembled_objects": { "const": 82 },
            "unclassified_types": { "const": 7 }
          }
        },
        "fingerprint_count": { "const": 981 },
        "fingerprint_digest": {
          "const": "sha256:e2ec8130f85f690eda663ac556b61e63ffd7d98e422c71f0245b10112161887f"
        },
        "observed_model_digest_before_materialization": {
          "const": "sha256:8db8abe9a2882c827f4aee55f7584f082f1ea7f31647783e7f52697443055d22"
        },
        "observed_source_digest_before_materialization": {
          "const": "sha256:590c51801b32a6661878de7956d1752b9f027bf2cd65ba2605e8120b682d91d3"
        },
        "owner_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme",
            "ingenierie_build_qualite"
          ],
          "properties": {
            "direction_editoriale_pedagogique": { "const": 98 },
            "direction_scientifique_programme": { "const": 752 },
            "ingenierie_build_qualite": { "const": 131 }
          }
        }
      }
    },
    "approved_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_active_fingerprint_count",
        "initial_active_fingerprint_count",
        "initial_baseline_digest",
        "initial_resolved_fingerprint_count",
        "modified_pairs",
        "modified_pairs_digest",
        "resolved_category_counts",
        "resolved_fingerprint_count",
        "resolved_fingerprint_digest",
        "retained_fingerprint_count"
      ],
      "properties": {
        "final_active_fingerprint_count": { "const": 2986 },
        "initial_active_fingerprint_count": { "const": 2647 },
        "initial_baseline_digest": {
          "const": "sha256:714c859e7a56e8034e16b3d5c6beeee350848594351076ac256764c180e2e9ff"
        },
        "initial_resolved_fingerprint_count": { "const": 0 },
        "modified_pairs": {
          "const": [
            {
              "current": "3276d95a8a9b8142",
              "previous": "9873ab6a1e11c673"
            },
            {
              "current": "d51832bdeebf5d4a",
              "previous": "63548ddb4dd6b1dd"
            },
            {
              "current": "a96d99c614321acc",
              "previous": "8fdec12020b7159b"
            }
          ]
        },
        "modified_pairs_digest": {
          "const": "sha256:eaa22aa607e9a9616f251cee24e8b639e9c958c639aac353b13fd01e18836dd1"
        },
        "resolved_category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_statuses",
            "broken_meta_references",
            "chapters_not_in_manual",
            "missing_assemblers",
            "unassembled_objects"
          ],
          "properties": {
            "blocking_statuses": { "const": 3 },
            "broken_meta_references": { "const": 24 },
            "chapters_not_in_manual": { "const": 3 },
            "missing_assemblers": { "const": 1 },
            "unassembled_objects": { "const": 611 }
          }
        },
        "resolved_fingerprint_count": { "const": 642 },
        "resolved_fingerprint_digest": {
          "const": "sha256:44397de4c98d70ce3575c04ea37322a403a29a3468bd29a23bffc938ed4908fc"
        },
        "retained_fingerprint_count": { "const": 2005 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approver_role",
        "baseline_purpose",
        "id",
        "provisional_after_freeze",
        "ref",
        "release_acceptance"
      ],
      "properties": {
        "approved_by": { "const": "Alaeddine Ben Rhouma" },
        "approver_role": {
          "const": "Direction scientifique et éditoriale Nexus Réussite"
        },
        "baseline_purpose": { "const": "debt_regression_control" },
        "id": { "const": "baseline-debt-extension-collection-2026-08-08" },
        "provisional_after_freeze": { "const": false },
        "ref": {
          "const": "audit/BASELINE_QUALIFICATION_DECISION.md#decision-baseline-debt-extension-collection-2026-08-08"
        },
        "release_acceptance": { "const": false }
      }
    },
    "decision_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "owner", "reason", "release_blocking"],
      "properties": {
        "disposition": {
          "enum": [
            "open_debt",
            "generated_dependency",
            "harvest_candidate",
            "intentional_reuse"
          ]
        },
        "owner": {
          "enum": [
            "direction_editoriale_pedagogique",
            "direction_scientifique_programme",
            "ingenierie_build_qualite"
          ]
        },
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "release_blocking": { "type": "boolean" }
      }
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "field_equals": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "integer", "number", "string", "null"]
          }
        },
        "field_in": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": ["boolean", "integer", "number", "string", "null"]
            },
            "uniqueItems": true
          }
        },
        "not_all_true": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        },
        "source_glob": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "not": {
            "required": ["all_true", "not_all_true"]
          }
        }
      ]
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "id", "match", "order"],
      "properties": {
        "decision": { "$ref": "#/$defs/decision_output" },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "match": { "$ref": "#/$defs/match" },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
