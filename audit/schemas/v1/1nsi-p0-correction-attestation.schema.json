{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:audit:schema:v1:1nsi-p0-correction-attestation",
  "title": "Nexus 1NSI P0 correction attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "manual",
    "p0_id",
    "source_commit_sha",
    "source_files",
    "reviewer_id",
    "reviewer_model",
    "review_run_id",
    "session_id",
    "generation_id",
    "cache_status",
    "commands",
    "verdict",
    "reviewed_at"
  ],
  "properties": {
    "artifact_type": { "const": "1nsi_p0_correction_attestation" },
    "schema_version": { "const": 1 },
    "manual": { "const": "1NSI" },
    "p0_id": {
      "type": "string",
      "pattern": "^1NSI-REV-[A-Z0-9-]+$"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_file" }
    },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": "string", "minLength": 1 },
    "review_run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "generation_id": { "type": "string", "minLength": 1 },
    "cache_status": {
      "enum": ["not_applicable", "miss", "hit"]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "verdict": { "enum": ["approved", "changes_required"] },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "cwd",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "result_summary"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_sha256": { "$ref": "#/$defs/sha256" },
        "result_summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
