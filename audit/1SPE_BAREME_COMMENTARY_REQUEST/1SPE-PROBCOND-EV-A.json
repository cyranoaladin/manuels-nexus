        {
          "competence": "modeliser",
          "correction_answer": "$P(M) = \\dfrac{3}{100}$, $P_M(T) = \\dfrac{9}{10}$, $P_{\\overline{M}}(T) = 1 - \\dfrac{96}{100} = \\dfrac{1}{25}$. \\medskip",
