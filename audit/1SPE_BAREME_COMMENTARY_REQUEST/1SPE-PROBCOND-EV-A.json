            "ce_qui_rapporte_les_points": "",
            "erreurs_penalisees": "",
            "points_de_redaction": ""
          }
        },
        {
          "competence": "calculer",
          "correction_answer": "$P(A \\cup B) = P(A) + P(B) - P(A \\cap B) = \\dfrac{1}{2} + \\dfrac{1}{5} - \\dfrac{1}{10} = \\dfrac{5+2-1}{10} = \\dfrac{3}{5}$. \\medskip",
          "correction_answer_scope": "question",
          "points": "1 pt",
          "question": "Q2",
          "statement": "Calculer $P(A \\cup B)$. \\hfill\\textit{(1 pt --- calculer)}",
          "to_be_written_by_a_teacher": {
            "ce_qui_rapporte_les_points": "",
            "erreurs_penalisees": "",
            "points_de_redaction": ""
          }
        },
