{
  "chapitre": "1SPE-PRODUIT-SCALAIRE",
  "titre": "Produit scalaire — QCM d'auto-évaluation",
  "questions": [
    {
      "id": "Q1",
      "capacite": "C1",
      "enonce": "Soient $\\vec{u}(3,-2)$ et $\\vec{v}(1,4)$. Que vaut $\\vec{u} \\cdot \\vec{v}$ ?",
      "options": {
        "A": "$-5$",
        "B": "$5$",
        "C": "$-11$",
        "D": "$11$"
      },
      "correcte": "A",
      "diagnostics": {
        "B": {
          "erreur": "Oubli du signe dans $(-2) \\times 4$.",
          "renvoi": "M1"
        },
        "C": {
          "erreur": "Erreur de calcul dans le produit des composantes.",
          "renvoi": "M1"
        },
        "D": {
          "erreur": "Addition des composantes au lieu du produit scalaire.",
          "renvoi": "M1"
        }
      }
    },
    {
      "id": "Q2",
      "capacite": "C1",
      "enonce": "Si $\\|\\vec{u}\\|=5$, $\\|\\vec{v}\\|=4$ et $(\\vec{u},\\vec{v}) = \\dfrac{\\pi}{3}$, quelle est la valeur de $\\vec{u} \\cdot \\vec{v}$ ?",
      "options": {
        "A": "$20$",
        "B": "$10$",
        "C": "$10\\sqrt{3}$",
        "D": "$10\\sqrt{2}$"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "Oubli du facteur $\\cos\\!\\left(\\dfrac{\\pi}{3}\\right) = \\dfrac{1}{2}$.",
          "renvoi": "M1"
        },
        "C": {
          "erreur": "Confusion entre le cosinus et le sinus.",
          "renvoi": "M1; R3"
        },
        "D": {
          "erreur": "Mauvaise valeur du cosinus de l'angle.",
          "renvoi": "M1; R3"
        }
      }
    },
    {
      "id": "Q3",
      "capacite": "C1",
      "enonce": "Le produit scalaire $\\vec{u} \\cdot \\vec{v}$ est :",
      "options": {
        "A": "un vecteur",
        "B": "un nombre réel",
        "C": "toujours positif",
        "D": "défini uniquement si $\\vec{u}$ et $\\vec{v}$ sont non nuls"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "Confusion avec le produit vectoriel.",
          "renvoi": "M1"
        },
        "C": {
          "erreur": "Le produit scalaire peut être négatif si l'angle est obtus.",
          "renvoi": "M1"
        },
        "D": {
          "erreur": "On pose $\\vec{u} \\cdot \\vec{v} = 0$ si l'un des vecteurs est nul.",
          "renvoi": "M1"
        }
      }
    },
    {
      "id": "Q4",
      "capacite": "C2",
      "enonce": "$\\Vert\\vec{u}+\\vec{v}\\Vert^2 = ?$",
      "options": {
        "A": "$\\Vert\\vec{u}\\Vert^2 + \\Vert\\vec{v}\\Vert^2$",
        "B": "$\\Vert\\vec{u}\\Vert^2 + 2\\vec{u}\\cdot\\vec{v} + \\Vert\\vec{v}\\Vert^2$",
        "C": "$\\Vert\\vec{u}\\Vert^2 - 2\\vec{u}\\cdot\\vec{v} + \\Vert\\vec{v}\\Vert^2$",
        "D": "$(\\vec{u}\\cdot\\vec{v})^2$"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "Oubli du double produit $2\\vec{u}\\cdot\\vec{v}$.",
          "renvoi": "M2"
        },
        "C": {
          "erreur": "Signe du double produit (c'est la formule pour $\\Vert\\vec{u}-\\vec{v}\\Vert^2$).",
          "renvoi": "M2"
        },
        "D": {
          "erreur": "Confusion entre norme du carré de la somme et carré du produit scalaire.",
          "renvoi": "M2"
        }
      }
    },
    {
      "id": "Q5",
      "capacite": "C2",
      "enonce": "$\\vec{u} \\cdot \\vec{u} = ?$",
      "options": {
        "A": "$\\Vert\\vec{u}\\Vert$",
        "B": "$\\Vert\\vec{u}\\Vert^2$",
        "C": "$2\\Vert\\vec{u}\\Vert$",
        "D": "$0$"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "Oubli du carré dans la définition du carré scalaire.",
          "renvoi": "M2"
        },
        "C": {
          "erreur": "Confusion de coefficient.",
          "renvoi": "M2"
        },
        "D": {
          "erreur": "$\\vec{u}\\cdot\\vec{u}=0$ si et seulement si $\\vec{u}=\\vec{0}$.",
          "renvoi": "M2"
        }
      }
    },
    {
      "id": "Q6",
      "capacite": "C2",
      "enonce": "Sachant que $\\|\\vec{u}\\|=3$, $\\|\\vec{v}\\|=4$ et $\\vec{u}\\cdot\\vec{v}=5$, quelle est la valeur de $\\|\\vec{u}+\\vec{v}\\|$ ?",
      "options": {
        "A": "$5$",
        "B": "$\\sqrt{35}$",
        "C": "$7$",
        "D": "$\\sqrt{25}$"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "$\\sqrt{25}=5$ mais $\\|\\vec{u}+\\vec{v}\\|^2 = 9 + 10 + 16 = 35$.",
          "renvoi": "M2"
        },
        "C": {
          "erreur": "Erreur d'application de la formule.",
          "renvoi": "M2"
        },
        "D": {
          "erreur": "$\\|\\vec{u}+\\vec{v}\\|^2 = 35$, et non $25$.",
          "renvoi": "M2"
        }
      }
    },
    {
      "id": "Q7",
      "capacite": "C3",
      "enonce": "Deux vecteurs non nuls $\\vec{u}$ et $\\vec{v}$ sont orthogonaux si et seulement si :",
      "options": {
        "A": "$\\vec{u}\\cdot\\vec{v} > 0$",
        "B": "$\\vec{u}\\cdot\\vec{v} < 0$",
        "C": "$\\vec{u}\\cdot\\vec{v} = 0$",
        "D": "$\\Vert\\vec{u}\\Vert = \\Vert\\vec{v}\\Vert$"
      },
      "correcte": "C",
      "diagnostics": {
        "A": {
          "erreur": "Le signe strict ne caractérise pas l'orthogonalité.",
          "renvoi": "M3"
        },
        "B": {
          "erreur": "Idem.",
          "renvoi": "M3"
        },
        "D": {
          "erreur": "Avoir la même norme ne garantit pas l'orthogonalité.",
          "renvoi": "M3"
        }
      }
    },
    {
      "id": "Q8",
      "capacite": "C3",
      "enonce": "Les vecteurs $\\vec{u}(2,3)$ et $\\vec{v}(3,-2)$ sont :",
      "options": {
        "A": "colinéaires",
        "B": "orthogonaux",
        "C": "de même norme",
        "D": "de sens contraire"
      },
      "correcte": "B",
      "diagnostics": {
        "A": {
          "erreur": "Le déterminant vaut $2 \\times (-2) - 3 \\times 3 = -13 \\neq 0$.",
          "renvoi": "M3"
        },
        "C": {
          "erreur": "$\\Vert\\vec{u}\\Vert = \\Vert\\vec{v}\\Vert = \\sqrt{13}$ est vrai mais l'orthogonalité est la propriété caractérisée.",
          "renvoi": "M3"
        },
        "D": {
          "erreur": "Option incorrecte.",
          "renvoi": "M3"
        }
      }
    },
    {
