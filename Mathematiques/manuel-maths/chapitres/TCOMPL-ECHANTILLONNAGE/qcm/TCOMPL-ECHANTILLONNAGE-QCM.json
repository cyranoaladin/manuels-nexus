  "questions": [
    {
      "id": "Q1",
      "capacite": "C1",
      "enonce": "L'intervalle de confiance usuel au niveau 95% pour une proportion p avec un echantillon de taille n est :",
      "correcte": "A",
      "options": {
        "A": "$[f - \\frac{1}{\\sqrt{n}} ; f + \\frac{1}{\\sqrt{n}}]$",
        "B": "$[f - \\frac{1}{n} ; f + \\frac{1}{n}]$",
        "C": "$[f - 1,96 ; f + 1,96]$",
        "D": "$[0 ; 1]$"
      },
      "diagnostics": {
        "B": {
          "erreur": "Erreur d'exposant sur n.",
          "renvoi": "C1"
        },
        "C": {
          "erreur": "Oubli de diviser par sqrt(n).",
          "renvoi": "C1"
        },
        "D": {
          "erreur": "Intervalle trivial non informatif.",
          "renvoi": "C1"
        }
      }
    },
    {
      "id": "Q2",
      "capacite": "C1",
