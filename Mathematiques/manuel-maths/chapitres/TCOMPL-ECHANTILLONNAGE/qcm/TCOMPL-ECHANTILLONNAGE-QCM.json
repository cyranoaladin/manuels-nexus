      "options": {
        "A": "Doublee",
        "B": "Triplee",
        "C": "Multipliee par 4",
        "D": "Divisee par 2"
      },
      "diagnostics": {
        "A": {
          "erreur": "Oubli de la racine carree au denominateur.",
          "renvoi": "C1"
        },
        "B": {
          "erreur": "Facteur 3 incorrect.",
          "renvoi": "C1"
        },
        "D": {
          "erreur": "Effet inverse.",
          "renvoi": "C1"
        }
      }
    },
    {
