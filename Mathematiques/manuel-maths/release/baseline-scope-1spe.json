{
  "schema_version": 2,
  "description": "Univers explicite et règles de classement de la baseline immuable 1SPE.",
  "universe": {
    "include": [
      ".github/workflows/ci.yml",
      "A_VALIDER_HUMAIN.md",
      "CAHIER_DES_CHARGES.md",
      "CLAUDE.md",
      "DIRECTIVES_EN_COURS.md",
      "ETAT_COLLECTION.md",
      "LF-*_rapport.md",
      "LOT-*_rapport.md",
      "MAQUETTE_V5_A_VALIDER.md",
      "MISSION_LOG.md",
      "Makefile",
      "RAPPORT_FINAL_1SPE.md",
      "README.md",
      "requirements.txt",
      "SPECIMEN_A_VALIDER.md",
      "backlog_tspe_v2/1SPE-*/**",
      "chapitres/1SPE-*/**",
      "docs/01_conception_manuel.md",
      "docs/02_workflow_production.md",
      "docs/03_architecture_technique.md",
      "docs/04_guide_agents.md",
      "docs/05_conventions_latex.md",
      "docs/06_charte_graphique.md",
      "docs/07_ligne_editoriale.md",
      "docs/superpowers/plans/2026-07-20-dynamic-rubric-tab-length.md",
      "docs/superpowers/plans/*1spe*",
      "docs/superpowers/specs/2026-07-20-dynamic-rubric-tab-length-design.md",
      "docs/superpowers/specs/*1spe*",
      "gabarits/**",
      "referentiel/*1SPE*",
      "referentiel/CONFORMITE_BO2026.md",
      "release/**",
      "schemas/**",
      "scripts/**",
      "sources/SOURCES.md",
      "sources/*1SPE*",
      "sources/registry.yaml",
      "sources/txt/*1SPE*",
      "tests/**",
      "transversal/**",
      "validations/**"
    ],
    "exclude": [
      {
        "pattern": "backlog_tspe_v2/TSPE-*/**",
        "justification": "Backlog explicitement réservé au manuel de terminale."
      },
      {
        "pattern": "chapitres/TSPE-*/**",
        "justification": "Chapitres du manuel de terminale, hors release 1SPE."
      },
      {
        "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-nsi.tex",
        "justification": "Spécimen NSI du kit de référence, non chargé par le manuel 1SPE."
      },
      {
        "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-physique.tex",
        "justification": "Spécimen de physique du kit de référence, hors mathématiques 1SPE."
      },
      {
        "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-suites.tex",
        "justification": "Spécimen de suites explicitement rédigé pour la terminale dans le kit de référence."
      },
      {
        "pattern": "gabarits/reference-v4/manuel-kit/main.tex",
        "justification": "Démonstrateur de manuel terminale chargeant des chapitres NSI et physique hors 1SPE."
      },
      {
        "pattern": "validations/E2/**",
        "justification": "Preuves du manuel NSI E2, distinctes de la release mathématiques 1SPE."
      }
    ]
  },
  "categories": [
    {
      "category": "attestation",
      "include": [
        "chapitres/1SPE-*/validations/**",
        "validations/**"
      ],
      "exclude": [
        {
          "pattern": "validations/E2/**",
          "justification": "Preuves NSI E2 explicitement hors release mathématiques 1SPE."
        }
      ]
    },
    {
      "category": "contract",
      "include": [
        "chapitres/1SPE-*/contrat.yaml",
        "requirements.txt",
        "release/**",
        "schemas/**"
      ],
      "exclude": []
    },
    {
      "category": "referential",
      "include": [
        "referentiel/*1SPE*",
        "referentiel/CONFORMITE_BO2026.md",
        "sources/SOURCES.md",
        "sources/*1SPE*",
        "sources/registry.yaml",
        "sources/txt/*1SPE*"
      ],
      "exclude": []
    },
    {
      "category": "directive",
      "include": [
        ".github/workflows/ci.yml",
        "CAHIER_DES_CHARGES.md",
        "CLAUDE.md",
        "DIRECTIVES_EN_COURS.md",
        "Makefile",
        "README.md",
        "docs/01_conception_manuel.md",
        "docs/02_workflow_production.md",
        "docs/03_architecture_technique.md",
        "docs/04_guide_agents.md",
        "docs/05_conventions_latex.md",
        "docs/06_charte_graphique.md",
        "docs/07_ligne_editoriale.md",
        "docs/superpowers/plans/2026-07-20-dynamic-rubric-tab-length.md",
        "docs/superpowers/plans/*1spe*",
        "docs/superpowers/specs/2026-07-20-dynamic-rubric-tab-length-design.md",
        "docs/superpowers/specs/*1spe*"
      ],
      "exclude": []
    },
    {
      "category": "report",
      "include": [
        "A_VALIDER_HUMAIN.md",
        "ETAT_COLLECTION.md",
        "LF-*_rapport.md",
        "LOT-*_rapport.md",
        "MAQUETTE_V5_A_VALIDER.md",
        "MISSION_LOG.md",
        "RAPPORT_FINAL_1SPE.md",
        "SPECIMEN_A_VALIDER.md",
        "chapitres/1SPE-*/LOT-*.md"
      ],
      "exclude": []
    },
    {
      "category": "source_1spe",
      "include": [
        "backlog_tspe_v2/1SPE-*/**",
        "chapitres/1SPE-*/**",
        "gabarits/**",
        "scripts/**",
        "tests/**",
        "transversal/**"
      ],
      "exclude": [
        {
          "pattern": "chapitres/1SPE-*/LOT-*.md",
          "justification": "Rapports de lots classés dans la catégorie report."
        },
        {
          "pattern": "chapitres/1SPE-*/contrat.yaml",
          "justification": "Contrats de chapitre classés dans la catégorie contract."
        },
        {
          "pattern": "chapitres/1SPE-*/validations/**",
          "justification": "Preuves de chapitre classées dans la catégorie attestation."
        },
        {
          "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-nsi.tex",
          "justification": "Spécimen NSI du kit de référence, explicitement hors univers."
        },
        {
          "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-physique.tex",
          "justification": "Spécimen de physique du kit de référence, explicitement hors univers."
        },
        {
          "pattern": "gabarits/reference-v4/manuel-kit/chapitres/chap-suites.tex",
          "justification": "Spécimen de terminale du kit de référence, explicitement hors univers."
        },
        {
          "pattern": "gabarits/reference-v4/manuel-kit/main.tex",
          "justification": "Démonstrateur terminale multidisciplinaire, explicitement hors univers."
        }
      ]
    }
  ]
}
