% nexus-nsi.sty — Adaptateur disciplinaire NSI (Nexus Réussite)
\NeedsTeXFormat{LaTeX2e}
% Ces gabarits sont chargés par leur chemin -- `../../gabarits/common/nexus-charte`
% depuis les mathématiques, autrement depuis la NSI. LaTeX comparait ce chemin au
% nom déclaré ici et signalait l'écart, une fois par fichier. `\@currname` EST le
% nom demandé : le fichier déclare donc qu'il est bien celui qu'on a appelé, et
% garde son identité lisible dans la description. Le noyau compare le nom déclaré
% à `\@currpath\@currname` : c'est donc cette paire, et non le seul `\@currname`,
% qui rend la déclaration exacte. Aucun `\@ifpackageloaded` du
% dépôt n'interroge ces noms ; l'identité des trois copies est prouvée par les
% tests d'égalité octet à octet, pas par cette ligne.
\ProvidesPackage{\@currpath\@currname}[2026/07/20 v6.0 nexus-nsi -- Adaptateur NSI - Canonique]
% traits 0.8pt, nxBleu structures, nxOr mises en évidence, nxGris repères.
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,matrix,shapes.multipart,calc,trees}

\tikzset{
  nxnode/.style={circle,draw=nxBleu,line width=0.8pt,minimum size=1.9em,font=\sffamily\small,inner sep=1pt},
  nxnodehl/.style={nxnode,fill=nxOr!25},
  nxedge/.style={draw=nxBleu,line width=0.8pt},
  nxarrow/.style={nxedge,-{Stealth[length=5pt]}},
  nxcell/.style={draw=nxGris,line width=0.6pt,minimum width=2.2em,minimum height=1.7em,font=\ttfamily\small},
  nxcellhl/.style={nxcell,fill=nxOr!20},
  nxref/.style={draw=nxRouge,line width=0.8pt,-{Stealth[length=5pt]},dashed},
}

% nxfigure et nxfig sont definis dans nexus-figures.tex (tronc commun)

% Tableau mémoire : \memtable{v1,v2,v3,...}{indice de départ}
\newcommand{\memtable}[2]{%
  \begin{tikzpicture}[node distance=0pt]
    \foreach [count=\i from #2] \v in {#1}{%
      \node[nxcell] (c\i) at ({(\i-#2)*2.2em},0) {\v};
      \node[font=\tiny\sffamily,color=nxGris,above=1pt of c\i] {\i};}
  \end{tikzpicture}}

% Arbre binaire compact : \nxbintree{racine}{sous-arbre gauche}{sous-arbre droit} en syntaxe child
% (utiliser directement tikz \node[nxnode] {r} child {...} pour les cas complexes)

% Table SQL : en-tête nxBleu!10
\newenvironment{sqltable}{\begin{center}\sffamily\small
  \rowcolors{2}{white}{nxGris!6}}{\end{center}}
