.venv/
__pycache__/
*.pyc
.env
raw/
corpus_nsi
corpus/**/*.json
*.aux
*.log
*.out
*.toc
*.pdf
!docs/**/*.pdf

# Artefacts de build. Seuls les PDF assembles canoniques sont versionnes :
# une edition eleve et une edition professeur par manuel, rien d'autre — meme
# regle que Mathematiques/manuel-maths/.gitignore. Toute autre declinaison
# serait un artefact qu'aucune commande ne sait reproduire.
build/*
!build/MANUEL_1NSI/
!build/MANUEL_TNSI/
build/MANUEL_1NSI/*
build/MANUEL_TNSI/*
!build/MANUEL_1NSI/MANUEL_1NSI_eleve.pdf
!build/MANUEL_1NSI/MANUEL_1NSI_professeur.pdf
!build/MANUEL_TNSI/MANUEL_TNSI_eleve.pdf
!build/MANUEL_TNSI/MANUEL_TNSI_professeur.pdf
